#pragma once

#define ORCA_UPDATER_SIG_KEY_B64 "@ORCA_UPDATER_SIG_KEY_B64@"
#define ORCA_UPDATER_SIG_KEY_AVAILABLE @ORCA_UPDATER_SIG_KEY_AVAILABLE@

// Commit the build was configured from (see the top-level CMakeLists.txt).
// A GIT_COMMIT_HASH given on the compiler command line takes precedence.
#ifndef GIT_COMMIT_HASH
#cmakedefine GIT_COMMIT_HASH "@GIT_COMMIT_HASH@"
#endif
#ifndef GIT_COMMIT_HASH
#define GIT_COMMIT_HASH "0000000" // 0000000 means uninitialized
#endif

